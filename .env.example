TOKENX_USDC_VAULT_ADDRESS=0xBa78aaB35f820c29627420D8413b106dd798Cb09
TOKENX_USDT_VAULT_ADDRESS=0x44f5D969769335B895fEd06fa6408aB56a891213
VAULT_STATS_REFRESH_MINUTES=30

BACKEND_SIGNER_ENABLED=false
BACKEND_SIGNER_PROVIDER=process-env
BACKEND_SIGNER_SECRET_REF=
# Development only. Keep the real value in an ignored local .env file.
BACKEND_SIGNER_MNEMONIC=
