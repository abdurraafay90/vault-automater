# No Postgres/Redis needed: auth, custom vaults and automation jobs all live
# in SQLite at .data/auth.sqlite (packages/database's Prisma+Postgres setup is
# unused dead code, not wired into the API).
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_SECONDS=28800

# Public URL of the deployed web console. Drives CORS, cookie Secure flag
# (auto-enabled when this is https:// and NODE_ENV=production), and the API's
# "/" redirect. Local dev: http://localhost:4560
APP_ORIGIN=https://vault.wickhub.cc
# Same URL, used only at build time for SEO metadata (canonical link, Open
# Graph image resolution). Has no effect on API calls.
NEXT_PUBLIC_SITE_URL=https://vault.wickhub.cc
# Leave empty. The browser always calls the same-origin /api/* proxy in
# apps/web; do not point this at the internal "api" Docker service name — the
# browser cannot resolve it.
NEXT_PUBLIC_API_URL=

# Set to "1" when exactly one reverse proxy sits in front of this app (Caddy,
# nginx, Cloudflare Tunnel, etc.) and appends X-Forwarded-For — needed so rate
# limits apply per real visitor instead of to everyone behind the proxy as one
# IP. Leave empty for local dev or a direct, unproxied deployment.
TRUST_PROXY=1

API_PORT=4000
LOG_LEVEL=info

# Server-side automation: the worker sends on schedule with the console closed.
# Wallet keys given to an automation or CSV batch are stored AES-256-GCM
# encrypted with this key and wiped when the automation stops / batch ends.
# Must decode to 32 bytes. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes stored keys unreadable (affected automations pause).
AUTOMATION_ENCRYPTION_KEY=
AUTOMATION_TICK_MS=1000
AUTOMATION_MAX_CONCURRENCY=4

# ------------------------------------------------------------------------------
# ZIGChain (mainnet)
# RPC_URL must be a Tendermint RPC endpoint (:26657 style, serves /status and
# /tx_search). API_URL must be the LCD/REST endpoint (serves /cosmos/...).
# They are NOT interchangeable — CosmJS signing uses RPC_URL.
# ------------------------------------------------------------------------------
CHAIN_TYPE=cosmos-sdk
CHAIN_NAME=ZIGChain
CHAIN_ID=zigchain-1
RPC_URL=https://zigchain-mainnet.zigscan.net
API_URL=https://zigchain-mainnet-lcd.zigscan.net
BLOCK_EXPLORER_URL=https://zigscan.org
NATIVE_TOKEN_SYMBOL=ZIG
NATIVE_TOKEN_DENOM=uzig
NATIVE_TOKEN_DECIMALS=6

# The asset moved by ZIGChain vaults: Noble USDC bridged over channel-3.
# The hash is SHA256("transfer/channel-3/uusdc"). Gas is paid separately in
# NATIVE_TOKEN_DENOM (uzig) above.
TOKEN_SYMBOL=USDC
TOKEN_DENOM=ibc/6490A7EAB61059BFC1CDDEB05917DD70BDF3A611654162A1A47DB930D40D8AF4
TOKEN_DECIMALS=6

# ------------------------------------------------------------------------------
# EVM — MAINNET ONLY. First URL is primary; the rest are automatic fallbacks.
# All endpoints below are keyless public RPCs, verified reachable.
# ------------------------------------------------------------------------------
EVM_MAINNET_CHAIN_ID=1
EVM_MAINNET_EXPLORER_URL=https://etherscan.io
ETH_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.drpc.org,https://rpc.mevblocker.io,https://eth.blockrazor.xyz,https://eth-pokt.nodies.app,https://gateway.tenderly.co/public/mainnet
ETH_WS_URLS=wss://ethereum-rpc.publicnode.com

BNB_MAINNET_CHAIN_ID=56
BNB_MAINNET_EXPLORER_URL=https://bscscan.com
BSC_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-rpc.publicnode.com,https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io,https://bsc-dataseed2.binance.org,https://bsc.rpc.blxrbdn.com
BSC_WS_URLS=wss://bsc-rpc.publicnode.com

IBC_SOURCE_PORT=transfer
IBC_SOURCE_CHANNEL=channel-3
IBC_TIMEOUT_SECONDS=600

ORBITER_CCTP_ENABLED=false
ORBITER_FEE_RECIPIENT=
ORBITER_FEE_AMOUNT=
ORBITER_CCTP_DESTINATION_DOMAIN=0
ORBITER_CCTP_MINT_RECIPIENT=
ORBITER_CCTP_DESTINATION_CALLER=
ORBITER_PASSTHROUGH_PAYLOAD=

VAULT_1_KEY=vault-1
VAULT_1_NAME=Stablecoin Yield
VAULT_1_ADDRESS=
VAULT_2_KEY=vault-2
VAULT_2_NAME=Opportunistic Credit
VAULT_2_ADDRESS=
VAULT_3_KEY=vault-3
VAULT_3_NAME=Core Income
VAULT_3_ADDRESS=

